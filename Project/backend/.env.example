# Database Configuration (Choose either DATABASE_URL or individual params)
# For Cloud (Neon.tech / Render / Supabase / Railway):
# DATABASE_URL=postgresql://username:password@ep-something.neon.tech/neondb?sslmode=require

# For Local PostgreSQL:
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=projdb

# JWT Secret Key
JWT_SECRET=your_jwt_secret_key_here

# Server Port
PORT=5000
